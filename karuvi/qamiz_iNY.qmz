// __karuvi/qamiz_iNY.qmz — தமிழ் இணை: every document has its Tamil twin__
// ஒவ்வொரு ஆவணத்துக்கும் அதன் தமிழ் இணை உள்ளதா என்று சரிபார்க்கும் கருவி
//
// __The rule (decision 0017): every Markdown file outside docs/ is written twice,__
// __X.md in English and X.ta.md in Tamil, and each links to the other near the top.__
// __docs/ is English only by decision, so it is skipped, as are .git, .github,__
// __node_modules and the test fixtures.__
//
// __A twin can be present and still be useless: a stale one, or a copy of the__
// __English. So besides existing and linking, it must have the same structure__
// __(headings, table rows, code fences) and enough words that begin with a Tamil__
// __letter to be Tamil at all. It cannot check that the Tamil is any good; that is__
// __for a Tamil speaker.__
//
// __This is a tool used only in this repository, so it lives here. If another__
// __repository wants the same check it belongs in nUlakam, and moves there.__

இறக்கு "nUlakam/kOppumuRY/kOppumuRY.qmz";
இறக்கு "nUlakam/atippatY/col.qmz";
இறக்கு "nUlakam/atippatY/aNi.qmz";

// __How many Tamil words a twin must have. A real translation has hundreds; this__
// __only catches a file that is a copy of the English.__
// தமிழ் இணையில் குறைந்தது இத்தனை தமிழ்ச் சொற்கள் வேண்டும்
செயல் குறைந்தது_சொற்கள்() { திரும்பு 10; }

// __How many lines at the top may hold the link to the other language.__
// மற்ற மொழிக்கான இணைப்பு இருக்க வேண்டிய முதல் வரிகளின் எண்ணிக்கை
செயல் இணைப்பு_வரிகள்() { திரும்பு 12; }

// __Folders, relative to the root, whose documents are not checked.__
// எந்தக் கோப்புறைகளின் ஆவணங்கள் சரிபார்க்கப்படாது
செயல் விலக்கு_முன்னொட்டுகள்() { திரும்பு ["docs/", ".github/", "karuvi/fixtures/"]; }

// __Folders, at any depth, that are never entered.__
// எங்கிருந்தாலும் உள்ளே செல்லக்கூடாத கோப்புறைகள்
செயல் விலக்கு_பெயர்கள்() { திரும்பு [".git", "node_modules"]; }

// __முன்னொட்டு_விலக்கா(உறவு_) — is this relative path under a skipped folder?__
// முன்னொட்டு_விலக்கா(உறவு_) — இந்தப் பாதை விலக்கப்பட்ட கோப்புறையின் கீழ் உள்ளதா
செயல் முன்னொட்டு_விலக்கா(உறவு_) {
    ஒவ்வொரு மு_ இல் விலக்கு_முன்னொட்டுகள்() {
        (தொடங்குகிறதா(உறவு_, மு_)) எனில் { திரும்பு மெய்; }
    }
    திரும்பு பொய்;
}

// __பெயர்_விலக்கா(பெயர்_) — is this folder name never entered?__
// பெயர்_விலக்கா(பெயர்_) — இந்தக் கோப்புறைக்குள் செல்லக்கூடாதா
செயல் பெயர்_விலக்கா(பெயர்_) {
    ஒவ்வொரு வி_ இல் விலக்கு_பெயர்கள்() {
        (பெயர்_ == வி_) எனில் { திரும்பு மெய்; }
    }
    திரும்பு பொய்;
}

// __ஆவணங்கள்_தேடு(வேர்_) — the Markdown files to check, as paths relative to the root.__
//
// __Its own walk, not கோப்பக_நட: that one enters every folder, and a node_modules__
// __holds thousands of files that are not ours. Sorted, so the report is stable.__
// ஆவணங்கள்_தேடு(வேர்_) — சரிபார்க்க வேண்டிய Markdown கோப்புகள், வேரிலிருந்து உறவுப் பாதையாக
செயல் ஆவணங்கள்_தேடு(வேர்_) {
    நேர்_வேர்_ = பாதை_இயல்பாக்கு(வேர்_);
    மீதம்_ = [""];
    விடை_ = [];
    (நீளம்(மீதம்_) > 0) சுற்று {
        இப்போது_ = மீதம்_[நீளம்(மீதம்_) - 1];
        மீதம்_ = துண்டு_அணி(மீதம்_, 0, நீளம்(மீதம்_) - 1);
        பெயர்கள்_ = கோப்பகம்_படி(பாதை_இணை(நேர்_வேர்_, இப்போது_));
        (சரியா(பெயர்கள்_)) எனில் {
            ஒவ்வொரு பெயர்_ இல் மதிப்பு(பெயர்கள்_) {
                உறவு_ = பாதை_இணை(இப்போது_, பெயர்_);
                (கோப்பகமா(பாதை_இணை(நேர்_வேர்_, உறவு_))) எனில் {
                    (இல்லை பெயர்_விலக்கா(பெயர்_) மற்றும் இல்லை முன்னொட்டு_விலக்கா(உறவு_ & "/")) எனில் {
                        மீதம்_ = இணை(மீதம்_, உறவு_);
                    }
                }
                இன்றேல் {
                    (நீட்சி(பெயர்_) == "md" மற்றும் இல்லை முன்னொட்டு_விலக்கா(உறவு_)) எனில் {
                        விடை_ = இணை(விடை_, உறவு_);
                    }
                }
            }
        }
    }
    திரும்பு வரிசையாக்கு(விடை_);
}

// __உரை_படி(பாதை_) — the whole file as text.__
// உரை_படி(பாதை_) — கோப்பு முழுவதும் உரையாக
செயல் உரை_படி(பாதை_) {
    கோப்பு_படி பாதை_, உள்ளடக்கம்_;
    திரும்பு உள்ளடக்கம்_;
}

// __அமைப்பு_எண்ணிக்கை(உரை_) — [headings, table rows, code fences].__
//
// __A line inside a code fence is code, not a heading: a shell comment starts with__
// __# too, and counting it would make two faithful translations disagree.__
// அமைப்பு_எண்ணிக்கை(உரை_) — [தலைப்புகள், அட்டவணை வரிகள், குறியீட்டு வேலிகள்]
செயல் அமைப்பு_எண்ணிக்கை(உரை_) {
    பகுதிகள்_ = 0;
    வரிசைகள்_ = 0;
    வேலிகள்_ = 0;
    உள்ளே_ = பொய்;
    ஒவ்வொரு வரி_ இல் பிரி(உரை_, "\n") {
        (தொடங்குகிறதா(வரி_, "```")) எனில் {
            வேலிகள்_ = வேலிகள்_ + 1;
            உள்ளே_ = இல்லை உள்ளே_;
        }
        இன்றேல் {
            (இல்லை உள்ளே_) எனில் {
                (தொடங்குகிறதா(வரி_, "#")) எனில் { பகுதிகள்_ = பகுதிகள்_ + 1; }
                (தொடங்குகிறதா(வரி_, "|")) எனில் { வரிசைகள்_ = வரிசைகள்_ + 1; }
            }
        }
    }
    திரும்பு [பகுதிகள்_, வரிசைகள்_, வேலிகள்_];
}

// __தமிழ்ச்_சொற்கள்(உரை_) — how many words begin with a Tamil letter.__
//
// __Word by word with the host split, never letter by letter: walking a long file__
// __a letter at a time is quadratic in this language.__
// தமிழ்ச்_சொற்கள்(உரை_) — தமிழ் எழுத்தில் தொடங்கும் சொற்களின் எண்ணிக்கை
செயல் தமிழ்ச்_சொற்கள்(உரை_) {
    எண்_ = 0;
    ஒவ்வொரு சொல்_ இல் பிரி(மாற்று(உரை_, "\n", " "), " ") {
        (நீளம்(சொல்_) > 0) எனில் {
            முதல்_எழுத்து_ = எழுத்து(சொல்_, 0);
            (முதல்_எழுத்து_ >= "அ" மற்றும் முதல்_எழுத்து_ <= "௺") எனில் { எண்_ = எண்_ + 1; }
        }
    }
    திரும்பு எண்_;
}

// __மேலே_உள்ளதா(உரை_, தேடல்_) — does the text mention this in its first lines?__
// மேலே_உள்ளதா(உரை_, தேடல்_) — முதல் வரிகளில் இது உள்ளதா
செயல் மேலே_உள்ளதா(உரை_, தேடல்_) {
    வரிகள்_ = பிரி(உரை_, "\n");
    எல்லை_ = நீளம்(வரிகள்_);
    (எல்லை_ > இணைப்பு_வரிகள்()) எனில் { எல்லை_ = இணைப்பு_வரிகள்(); }
    இ_ = 0;
    (இ_ < எல்லை_) சுற்று {
        (கொண்டுள்ளதா(வரிகள்_[இ_], தேடல்_)) எனில் { திரும்பு மெய்; }
        இ_ = இ_ + 1;
    }
    திரும்பு பொய்;
}

// __சோடி_சிக்கல்கள்(வேர்_, ஆங்கிலம்_, தமிழ்_) — what is wrong with one existing pair.__
// சோடி_சிக்கல்கள்(வேர்_, ஆங்கிலம்_, தமிழ்_) — இருக்கும் ஒரு இணையில் உள்ள குறைகள்
செயல் சோடி_சிக்கல்கள்(வேர்_, ஆங்கிலம்_, தமிழ்_) {
    சிக்கல்_ = [];
    ஆ_உரை_ = உரை_படி(பாதை_இணை(வேர்_, ஆங்கிலம்_));
    த_உரை_ = உரை_படி(பாதை_இணை(வேர்_, தமிழ்_));

    (இல்லை மேலே_உள்ளதா(ஆ_உரை_, அடிப்பெயர்(தமிழ்_))) எனில் {
        சிக்கல்_ = இணை(சிக்கல்_, ஆங்கிலம்_ & ": does not link to " & அடிப்பெயர்(தமிழ்_)
                      & " in its first lines  (இணைப்பு இல்லை)");
    }
    (இல்லை மேலே_உள்ளதா(த_உரை_, அடிப்பெயர்(ஆங்கிலம்_))) எனில் {
        சிக்கல்_ = இணை(சிக்கல்_, தமிழ்_ & ": does not link to " & அடிப்பெயர்(ஆங்கிலம்_)
                      & " in its first lines  (இணைப்பு இல்லை)");
    }

    ஆ_எண்_ = அமைப்பு_எண்ணிக்கை(ஆ_உரை_);
    த_எண்_ = அமைப்பு_எண்ணிக்கை(த_உரை_);
    பெயர்கள்_ = ["headings", "table rows", "code fences"];
    இ_ = 0;
    (இ_ < 3) சுற்று {
        (ஆ_எண்_[இ_] != த_எண்_[இ_]) எனில் {
            சிக்கல்_ = இணை(சிக்கல்_, தமிழ்_ & ": " & பெயர்கள்_[இ_] & " differ, English "
                          & ஆ_எண்_[இ_] & ", Tamil " & த_எண்_[இ_] & "  (அமைப்பு வேறுபடுகிறது)");
        }
        இ_ = இ_ + 1;
    }

    சொற்கள்_ = தமிழ்ச்_சொற்கள்(த_உரை_);
    (சொற்கள்_ < குறைந்தது_சொற்கள்()) எனில் {
        சிக்கல்_ = இணை(சிக்கல்_, தமிழ்_ & ": only " & சொற்கள்_ & " Tamil words, at least "
                      & குறைந்தது_சொற்கள்() & " expected  (தமிழ்ச் சொற்கள் போதவில்லை)");
    }
    திரும்பு சிக்கல்_;
}

// __இணை_சிக்கல்கள்(வேர்_) — every problem under the root, as sentences. Empty means all is well.__
// இணை_சிக்கல்கள்(வேர்_) — வேரின் கீழுள்ள எல்லாக் குறைகளும் வாக்கியங்களாக; வெற்றுப் பட்டியல் என்றால் எல்லாம் சரி
செயல் இணை_சிக்கல்கள்(வேர்_) {
    ஆவணங்கள்_ = ஆவணங்கள்_தேடு(வேர்_);
    சிக்கல்_ = [];
    ஒவ்வொரு உறவு_ இல் ஆவணங்கள்_ {
        (முடிகிறதா(உறவு_, ".ta.md")) எனில் {
            ஆங்கிலம்_ = துண்டு(உறவு_, 0, நீளம்(உறவு_) - 6) & ".md";
            (இல்லை உள்ளதா(ஆவணங்கள்_, ஆங்கிலம்_)) எனில் {
                சிக்கல்_ = இணை(சிக்கல்_, உறவு_ & ": no English file " & ஆங்கிலம்_
                              & "  (ஆங்கிலக் கோப்பு இல்லை)");
            }
        }
        இன்றேல் {
            தமிழ்_ = துண்டு(உறவு_, 0, நீளம்(உறவு_) - 3) & ".ta.md";
            (இல்லை உள்ளதா(ஆவணங்கள்_, தமிழ்_)) எனில் {
                சிக்கல்_ = இணை(சிக்கல்_, உறவு_ & ": no Tamil twin " & தமிழ்_
                              & "  (தமிழ் இணை இல்லை)");
            }
            இன்றேல் {
                ஒவ்வொரு ஒன்று_ இல் சோடி_சிக்கல்கள்(வேர்_, உறவு_, தமிழ்_) {
                    சிக்கல்_ = இணை(சிக்கல்_, ஒன்று_);
                }
            }
        }
    }
    திரும்பு சிக்கல்_;
}
